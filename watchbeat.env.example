# ═══════════════════════════════════════════════════════════════
# WatchBeat — Variables de Entorno
# Monitor de uptime self-hosted
# ═══════════════════════════════════════════════════════════════
#
# Copia este fichero a .env y edítalo con tus valores:
#   cp watchbeat.env.example .env
#   $EDITOR .env
#
# Las variables marcadas como (obligatorio) SON REQUERIDAS
# para que WatchBeat arranque. El resto tienen valores por
# defecto sensatos.
#
# ═══════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════
# SERVIDOR
# ═══════════════════════════════════════════════════════════════

# Puerto donde escuchará WatchBeat (por defecto: 3055)
# Lo usan tanto compose.yml como el binario directamente.
WATCHBEAT_PORT=3055

# Host de escucha (no tocar si usas Docker)
HOST=0.0.0.0

# Puerto interno del contenedor (no cambiar si usas compose.yml)
PORT=3055

# Directorio donde WatchBeat guarda la base de datos
DATA_DIR=./data

# Ruta completa al fichero SQLite
DATABASE_URL=./data/watchbeat.db

# Zona horaria para los registros y marcas de tiempo
# Lista completa: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Europe/Madrid

# Nivel de log (trace, debug, info, warn, error)
RUST_LOG=info

# Formato del log: "pretty" para desarrollo legible, "json" para producción
LOG_FORMAT=pretty


# ═══════════════════════════════════════════════════════════════
# AUTENTICACIÓN OIDC (obligatorio)
# ═══════════════════════════════════════════════════════════════
#
# WatchBeat requiere un proveedor OIDC externo.
# Ejemplos compatibles: Authentik, Keycloak, Authelia,
# Google Workspace, Azure AD, Okta, etc.
#
# Si no tienes uno, consulta:
#   https://goauthentik.io/   (recomendado, self-hosted)

# URL del emisor OIDC (obligatorio)
# Ejemplo con Authentik:  https://auth.tudominio.com/application/o/watchbeat/
# Ejemplo con Keycloak:   https://auth.tudominio.com/realms/tu-realm
# Ejemplo con Authelia:   https://auth.tudominio.com
OIDC_ISSUER_URL=https://auth.tuservidor.com

# Client ID registrado en el proveedor OIDC (obligatorio)
OIDC_CLIENT_ID=watchbeat

# Client Secret del proveedor OIDC (obligatorio)
OIDC_CLIENT_SECRET=tu-secreto-muy-largo-y-seguro

# ═══════════════════════════════════════════════════════════════
# OIDC_REDIRECT_URL — ¡ATENCIÓN! ⚠️
# ═══════════════════════════════════════════════════════════════
#
# Esta URL debe coincidir EXACTAMENTE con la "Redirect URI"
# registrada en tu proveedor OIDC. Es la causa #1 de errores
# de autenticación. Cualquier diferencia (una barra, http vs
# https, puerto omitido) hará que el login falle.
#
# El path SIEMPRE es:  /auth/callback
#
# ── Ejemplos ──────────────────────────────────────────────────
#
# Local (desarrollo):
#   http://localhost:3055/auth/callback
#
# Docker + reverse proxy (producción):
#   https://watchbeat.tudominio.com/auth/callback
#
# Docker con puerto personalizado:
#   https://watchbeat.tudominio.com:8443/auth/callback
#
# ── Regla de oro ──────────────────────────────────────────────
#   Copia y pega la URL EXACTA que pusiste en la configuración
#   de tu proveedor OIDC. No la reescribas de memoria.
#
OIDC_REDIRECT_URL=http://localhost:3055/auth/callback


# ═══════════════════════════════════════════════════════════════
# NOTIFICADORES
# ═══════════════════════════════════════════════════════════════
#
# Los notificadores se configuran DESDE LA INTERFAZ WEB
# (Settings → Notifiers), no vía variables de entorno.
#
# Esta sección solo existe como referencia documental de los
# campos que necesitarás en cada tipo de notificador.
#
# ── Telegram ──
#   Tipo:     "telegram"
#   Campos:   bot_token, chat_id
#
# ── Matrix ──
#   Tipo:     "matrix"
#   Campos:   homeserver_url, access_token, room_id
#
# ── ntfy.sh ──
#   Tipo:     "ntfy"
#   Campos:   topic, server_url (opcional, def: https://ntfy.sh), token (opcional)
#
# ── Webhook ──
#   Tipo:     "webhook"
#   Campos:   url, method (opcional, def: POST), headers (opcional, JSON)
#
# ── Slack ──
#   Tipo:     "slack"
#   Campos:   webhook_url
#
# ── Discord ──
#   Tipo:     "discord"
#   Campos:   webhook_url
#
# ── Email (SMTP) ──
#   Tipo:     "email"
#   Campos:   smtp_host, smtp_port, username, password, from, to
#
# ── Gotify ──
#   Tipo:     "gotify"
#   Campos:   server_url, app_token, priority (opcional, def: 5)